# Existing audit integrations
SEMRUSH_API_KEY=your_semrush_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PAGESPEED_API_KEY=

# Local macOS CLI development
SCREAMING_FROG_PATH=/Applications/Screaming Frog SEO Spider.app/Contents/MacOS/ScreamingFrogSEOSpiderLauncher

# Supabase is intentionally unconfigured until a project is provided.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SHARE_SESSION_SECRET=

# Worker runtime
WORKER_ID=seo-audit-worker-1
WORKER_POLL_SECONDS=5
AUDIT_WORK_ROOT=/tmp/seo-audits

# Render worker only: base64-encoded Screaming Frog licence.txt contents.
SCREAMING_FROG_LICENSE_B64=
