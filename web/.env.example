# Leave these blank to run the UI with local mock data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Use a Supabase pooler connection string in Vercel.
SUPABASE_DB_URL=

# At least 32 random bytes, used to sign short-lived client portal sessions.
SHARE_SESSION_SECRET=

# Server-only: report editing chatbot uses gpt-5.6-terra.
OPENAI_API_KEY=

# Server-only Semrush v3 key for report chat keyword research (US database)
SEMRUSH_API_KEY=
